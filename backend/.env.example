# Backend (SQLite is included; no separate database service is needed)
DATABASE_URL=sqlite:///./resume_search.db

# AI resume parsing and matching (optional; obtain a key from Groq)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Setup.ps1 generates a strong local secret. If configuring manually, replace this
# value with at least 32 random characters before starting the backend.
JWT_SECRET=replace_with_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email notifications are disabled by default. Configure Resend to enable them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_ENABLED=false

# Smodin web-source similarity check through RapidAPI (optional)
RAPIDAPI_KEY=
PLAGIARISM_THRESHOLD=30

# AI-authorship estimate through RapidAPI (optional)
# The AI detector uses RAPIDAPI_KEY when this separate override is blank.
# Subscribe to the AI Generated Content Detector BASIC plan in RapidAPI first.
RAPIDAPI_AI_DETECTOR_KEY=
RAPIDAPI_AI_DETECTOR_HOST=ai-generated-content-detector.p.rapidapi.com
RAPIDAPI_AI_DETECTOR_URL=https://ai-generated-content-detector.p.rapidapi.com/data
