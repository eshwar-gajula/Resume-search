# Production example only. Replace every placeholder in the deployment environment.
DATABASE_URL=mysql+pymysql://resumeai:URL_ENCODED_PASSWORD@127.0.0.1:3306/resume_search?charset=utf8mb4
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
CORS_ORIGINS=https://your-frontend.example.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
EMAIL_ENABLED=false
RAPIDAPI_KEY=
RAPIDAPI_AI_DETECTOR_KEY=
RAPIDAPI_AI_DETECTOR_HOST=ai-generated-content-detector.p.rapidapi.com
RAPIDAPI_AI_DETECTOR_URL=https://ai-generated-content-detector.p.rapidapi.com/data
PLAGIARISM_THRESHOLD=30
