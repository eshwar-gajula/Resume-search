[Unit]
Description=ResumeIQ Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=resumeiq
Group=resumeiq
WorkingDirectory=/opt/resumeiq/frontend
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
